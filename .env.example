# ─────────────────────────────────────────────────────────────────────────────
# eero Fetch — environment template
#
# Copy to .env.local and fill in. Every integration follows the same pattern:
#   - server creds enable the LIVE path
#   - a NEXT_PUBLIC_* flag flips the client seam from simulated → live
# A feature runs fully live only when BOTH are set.
#
# Prove readiness anytime with:  curl -s localhost:3000/api/health | jq
# ─────────────────────────────────────────────────────────────────────────────

# ── AI summaries (Amazon Bedrock) ────────────────────────────────────────────
# Set the flag to 'bedrock' to call the model; unset → computed fallback.
NEXT_PUBLIC_AI_SUMMARY=            # bedrock | (unset)
BEDROCK_MODEL_ID=                  # e.g. anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_REGION=us-east-1           # falls back to AWS_REGION, then us-east-1
# AWS credentials are resolved by the default provider chain (IAM role on the
# host, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN, or SSO).

# ── Survey engagement (Qualtrics completedResponse webhook) ───────────────────
NEXT_PUBLIC_ENGAGEMENT_SOURCE=     # qualtrics | (unset → simulated engagement)
QUALTRICS_BASE_URL=                # e.g. https://iad1.qualtrics.com/API/v3
QUALTRICS_API_TOKEN=               # token with event-subscription + read scope
QUALTRICS_DIRECTORY_ID=            # e.g. POOL_xxxxxxxx (for mailing lists)
QUALTRICS_WEBHOOK_SECRET=          # shared secret; appended as ?secret= on the
                                   # publicationUrl so only Qualtrics can post
QUALTRICS_RATING_QID=              # optional; question id holding the 1-5 rating
                                   # (survey-specific, e.g. QID58) for feedback quality
# Live delivery ALSO needs a public https URL for /api/qualtrics/webhook.
# Register it: node scripts/register-qualtrics-webhook.mjs --survey SV_xxx --url https://<host>

# ── JIRA (create tickets from survey findings) ───────────────────────────────
JIRA_BASE_URL=https://eeroinc.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
NEXT_PUBLIC_JIRA_BASE_URL=https://eeroinc.atlassian.net
NEXT_PUBLIC_JIRA_EPIC_KEY=BPM-1886

# ── Databricks (tester roster / network sync) ────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TESTER_TABLE=
# Optional overrides:
# DATABRICKS_TESTER_COLUMNS={"email":"email_col",...}
# DATABRICKS_NODES_TABLE=redshift_catalog.core.node_sessions
# DATABRICKS_ADMINS_TABLE=redshift_catalog.core.network_admins
# DATABRICKS_USERS_TABLE=redshift_catalog.core.users
# DATABRICKS_NETWORKS_TABLE=redshift_catalog.core.networks

# ── eero API — DUAL-CLOUD device ↔ network matching (device sync + roster) ────
# eero Fetch is standalone and spans BOTH clouds:
#   BETA testers/devices    → PRODUCTION eero API
#   DOGFOOD testers/devices → STAGE eero API
# Each cloud has its own base URL + session token. The app routes per cohort:
# beta serials hit the prod pair, dogfood serials hit the stage pair. If a cloud's
# token is missing, that cloud falls back to deterministic seed data (UI still works).
NEXT_PUBLIC_DEVICE_SYNC_SOURCE=    # insight (default) | databricks

# PRODUCTION (beta)
EERO_USER_API_BASE_PROD=https://api-user.e2ro.com
EERO_API_TOKEN_PROD=               # prod eero User API session/bearer token

# STAGE (dogfood) — host confirmed from the eero CLI creds store (~/.config/eero/creds.ini).
# Note: the eero CLI distinguishes --ci.stage vs --dev.stage; confirm which subset
# the dogfood networks live on with the eero API team.
EERO_USER_API_BASE_STAGE=https://api-user.stage.e2ro.com
EERO_API_TOKEN_STAGE=              # stage eero User API session/bearer token

# Legacy single-env vars (still read as the PROD pair if the _PROD ones are unset):
# EERO_USER_API_BASE=https://api-user.e2ro.com
# EERO_API_TOKEN=

# ADMIN API — global by-serial device lookup (VERIFIED: this is where serial→device
# resolution lives; the User API is account-scoped). Route: GET /eeros/serial/{serial}
# then GET /nodes/{id} for status(green=online)+firmware. Hosts confirmed via eero CLI.
EERO_ADMIN_API_BASE_PROD=https://api-admin.e2ro.com
EERO_ADMIN_API_TOKEN_PROD=         # prod eero Admin API token
EERO_ADMIN_API_BASE_STAGE=https://api-admin.stage.e2ro.com
EERO_ADMIN_API_TOKEN_STAGE=        # stage eero Admin API token

# How to get a token (per cloud): authenticate the eero User API session, e.g.
#   eero api user --prod  auth --sso     # then copy the session token → EERO_API_TOKEN_PROD
#   eero api user --stage auth --sso     # → EERO_API_TOKEN_STAGE
# (Must be on VPN. Confirm the exact CLI/flow with the eero API team.)
# Then confirm readiness per cloud:  curl -s "localhost:3000/api/insight?op=status" | jq

# ── Environment-aware deep-links (Insight/Admin) ──────────────────────────────
# Prod hosts are built in (insight.eero.com / admin.e2ro.com). Set the STAGE hosts
# so dogfood devices link to stage Insight/Admin instead of rendering as plain text.
NEXT_PUBLIC_INSIGHT_STAGE_URL=https://insight.stage.e2ro.com   # confirmed (web-eero-insight config; note .e2ro.com not .eero.com)
NEXT_PUBLIC_ADMIN_STAGE_URL=https://admin.stage.e2ro.com       # confirmed (eero tooling)

# ── SSO (app-level OIDC — e.g. Okta) ─────────────────────────────────────────
# When OIDC_ISSUER is set, the app uses SSO sign-in. When unset, it falls back to
# the @eero.com email login for local dev. The @eero.com roster stays the
# AUTHORIZATION layer (who's allowed + their role) on top of SSO authentication.
OIDC_ISSUER=                       # e.g. https://eero.okta.com/oauth2/default
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_SECRET=                       # random 32+ byte secret for session encryption (openssl rand -base64 32)
NEXTAUTH_URL=                      # the app's public base URL (e.g. https://<host>) — for OAuth callbacks

# ── Dogfood inventory (Breadboard) ───────────────────────────────────────────
NEXT_PUBLIC_INVENTORY_SOURCE=      # breadboard | (unset → local seed store)
BREADBOARD_API_BASE=
